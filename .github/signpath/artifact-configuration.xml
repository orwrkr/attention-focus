<?xml version="1.0" encoding="utf-8"?>
<!-- Enter this in the SignPath project. The workflow uploads the EXE as a ZIP artifact. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="attention-focus.exe" product-name="Attention Focus" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
